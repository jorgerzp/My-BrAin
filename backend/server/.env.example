# Puerto HTTP del API (por defecto 3001). Si ves EADDRINUSE, cierra la otra instancia o usa PORT=3002
# y actualiza frontend/vite.config.js → server.proxy['/api'].target al mismo host:puerto.
PORT=3001
GROQ_API_KEY=tu_clave_de_groq_aqui

# Credenciales de Tink Open Banking API
TINK_CLIENT_ID=tu_client_id_aqui
TINK_CLIENT_SECRET=tu_client_secret_aqui

# Configuración de PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/mybrain

# Configuración de Correo (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM="MyBrAIn" <tu_correo@gmail.com>

# Clave secreta para sesiones
SESSION_SECRET=una_clave_secreta_muy_larga_y_segura
